# Application
ENVIRONMENT=development
PROJECT_NAME="LocalGPT Phase 3"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/localgpt_phase3

# JWT & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# LLM Endpoint Configuration
# Phase 3 requires Hosted LLM endpoint (e.g. OpenAI-compatible / Groq / HuggingFace / Ollama / vLLM)
LLM_PROVIDER=hosted_endpoint
HOSTED_LLM_API_BASE=https://api.openai.com/v1
HOSTED_LLM_API_KEY=your-api-key-here
HOSTED_LLM_MODEL=gpt-4o-mini

# Document Storage & Uploads
UPLOAD_STORAGE_DIR=./data/documents
FAISS_INDEX_DIR=./data/vector_store
