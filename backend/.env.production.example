# =============================================================================
# LocalGPT Phase 3 - Production Environment Configuration Template
# Copy this file to .env in your production environment and populate all values.
# NEVER commit the filled .env file with actual credentials to version control.
# =============================================================================

# --- 1. Core Application Settings ---
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="LocalGPT Phase 3 API"
API_V1_STR="/api/v1"

# --- 2. Production CORS Origins ---
# Comma-separated list of allowed frontend domains or JSON string array.
# Example: https://app.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com

# --- 3. Production PostgreSQL Database ---
# Must use the asyncpg driver (postgresql+asyncpg://...)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://app_user:StrongPasswordHere@postgres-cluster.internal:5432/localgpt_prod

# --- 4. JWT Authentication & Security ---
# Generate a secure 64-character secret with: openssl rand -hex 32
# DO NOT leave default or predictable keys in production!
SECRET_KEY=generate_and_paste_a_secure_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 5. Google OAuth 2.0 (Optional) ---
# Retrieve from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.yourdomain.com/auth/callback/google

# --- 6. Hosted LLM Provider ---
# Compatible with OpenAI, Groq, Together, vLLM, LiteLLM, Ollama, Hugging Face
LLM_PROVIDER=hosted_endpoint
HOSTED_LLM_API_BASE=https://api.openai.com/v1
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=gpt-4o-mini

# --- 7. Persistent File & Vector Storage ---
# For container / cloud mounts, set absolute paths to persistent volume mount points.
# Example: /var/lib/localgpt/documents and /var/lib/localgpt/vector_store
UPLOAD_STORAGE_DIR=/var/lib/localgpt/documents
FAISS_INDEX_DIR=/var/lib/localgpt/vector_store
MAX_FILE_SIZE_BYTES=26214400  # 25 MB in bytes
